<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

  <TextView
      android:id="@+id/txtHeading"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:text="QUẢN LÝ BÀI VIẾT"
      android:textSize="22sp"
      android:textStyle="bold"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <TextView
      android:id="@+id/txtId"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Mã bài viết:"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@id/etId"
      app:layout_constraintBottom_toBottomOf="@id/etId" />

  <EditText
      android:id="@+id/etId"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:hint="Nhập mã bài viết"
      android:inputType="text"
      android:singleLine="true"
      app:layout_constraintStart_toEndOf="@id/txtId"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toBottomOf="@id/txtHeading"
      app:layout_constraintHorizontal_weight="1" />

  <TextView
      android:id="@+id/txtTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Tiêu đề:"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@id/etTitle"
      app:layout_constraintBottom_toBottomOf="@id/etTitle" />

  <EditText
      android:id="@+id/etTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:hint="Nhập tiêu đề bài viết"
      android:inputType="textCapSentences"
      android:singleLine="true"
      app:layout_constraintStart_toEndOf="@id/txtTitle"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toBottomOf="@id/etId" />

  <TextView
      android:id="@+id/txtContent"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Nội dung:"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@id/etContent" />

  <EditText
      android:id="@+id/etContent"
      android:layout_width="0dp"
      android:layout_height="100dp"
      android:layout_marginStart="12dp"
      android:hint="Nhập nội dung bài viết"
      android:gravity="top|start"
      android:inputType="textMultiLine|textCapSentences"
      app:layout_constraintStart_toEndOf="@id/txtContent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toBottomOf="@id/etTitle" />

  <TextView
      android:id="@+id/txtImageUrl"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Image URL:"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@id/etImageUrl"
      app:layout_constraintBottom_toBottomOf="@id/etImageUrl" />

  <EditText
      android:id="@+id/etImageUrl"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:hint="Nhập đường dẫn hình ảnh"
      android:inputType="textUri"
      android:singleLine="true"
      app:layout_constraintStart_toEndOf="@id/txtImageUrl"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toBottomOf="@id/etContent" />

  <Button
      android:id="@+id/btnSave"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="Lưu bài viết"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toStartOf="@id/btnShow"
      app:layout_constraintTop_toBottomOf="@id/etImageUrl"
      app:layout_constraintHorizontal_weight="1" />

  <Button
      android:id="@+id/btnShow"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_marginTop="12dp"
      android:text="Xem danh sách"
      app:layout_constraintStart_toEndOf="@id/btnSave"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toBottomOf="@id/etImageUrl"
      app:layout_constraintHorizontal_weight="1" />

  <TextView
      android:id="@+id/txtStatus"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center"
      android:text=""
      android:textSize="14sp"
      app:layout_constraintTop_toBottomOf="@id/btnSave"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>